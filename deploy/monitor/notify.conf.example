# 推送渠道配置 (复制 notify.conf.example 为 notify.conf 并填入你自己的 key)
# 留空/不建此文件 = 只写日志和 Redis, 不推送
#
# Server酱 (微信推送, https://sct.ftqq.com 免费申请):
# NOTIFY_TYPE=serverchan
# NOTIFY_KEY=SCTxxxxxxxxxxxx
#
# Bark (iPhone 推送, App Store 装 Bark 后复制示例 URL 里的 key):
# NOTIFY_TYPE=bark
# NOTIFY_KEY=你的设备key

NOTIFY_TYPE=
NOTIFY_KEY=
