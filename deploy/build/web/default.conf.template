server {
    listen 80;
    server_name ${SERVER_NAME};
    root /usr/share/nginx/html;

    ######### 反向代理 start ########
    location /api {
        proxy_pass http://${BACKEND_HOST}:${SERVER_PORT};
        # 获取真实 IP 
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $remote_addr;

        # 后端限制单个上传文件 10MB, 这里留一点 multipart 的余量,
        # 超出的请求在 Nginx 就挡掉, 不用把整个 body 转给后端
        client_max_body_size 12M;
    }
    # Gin 处理静态资源, Nginx 反向代理 Gin (本地文件上传才需要)
    location /public/uploaded {
        proxy_pass http://${BACKEND_HOST}:${SERVER_PORT}/public/uploaded;
    }
    location /admin/public/uploaded {
        proxy_pass http://${BACKEND_HOST}:${SERVER_PORT}/public/uploaded;
    }
    ######### 反向代理 end ########

    ######### 静态资源 start ########
    location / {
        try_files $uri $uri/ /index.html;
    }
    location /admin {
        try_files $uri $uri/ /admin/index.html;
    }
    location ~ .*\.(js|json|css)$ {
        gzip on;
        gzip_static on;
        gzip_min_length 1k;
        gzip_http_version 1.1;
        gzip_comp_level 9;
        gzip_types text/css application/javascript application/json;
        root /usr/share/nginx/html;
    }
    # SPA 入口禁止缓存: 每次部署新版本, 访客下次请求立即拿到新页面,
    # 不会出现"旧页面引用的脚本已被新部署替换 -> 点击无响应"的窗口期
    location ~* \.html$ {
        add_header Cache-Control "no-cache, must-revalidate";
    }
    # 带内容哈希的构建产物可以放心长期缓存 (文件名变了 URL 就变)
    location ^~ /assets/ {
        gzip_static on;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }
    location ^~ /admin/assets/ {
        gzip_static on;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }
    ######### 静态资源 end ########
}